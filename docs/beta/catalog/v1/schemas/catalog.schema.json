{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/terryncew/openline-bureau/blob/main/catalog/schemas/catalog.schema.json",
  "title": "OpenLine public beta catalog v1",
  "description": "The data-only Bureau compiler adds URL safety, size budgets, exact digest binding, role and reference checks beyond this shape schema.",
  "type": "object",
  "properties": {
    "format": {
      "const": "openline.catalog.v1"
    },
    "synthetic": {
      "type": "boolean"
    },
    "submission": {
      "type": "object",
      "properties": {
        "repository_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://[^\\s]+$"
        },
        "contribution_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://[^\\s]+$"
        },
        "catalog_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://[^\\s]+$"
        }
      },
      "required": [
        "repository_url",
        "contribution_url",
        "catalog_url"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "inquiries_enabled": {
          "type": "boolean"
        },
        "payment_processing": {
          "const": false
        },
        "contributed_code_execution": {
          "const": false
        },
        "attribution_limit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "ranking": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "fixture_notice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "inquiries_enabled",
        "payment_processing",
        "contributed_code_execution",
        "attribution_limit",
        "ranking"
      ],
      "additionalProperties": false
    },
